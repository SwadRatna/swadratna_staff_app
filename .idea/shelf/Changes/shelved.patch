lue = true\n            _error.value = null\n            repository.recordBillPayment(billId, request)\n                .onSuccess {\n                    _paymentSuccess.emit(it)\n                    orderIdForRefresh?.let { getBillDetails(it) }\n                }\n                .onFailure { _error.value = it.message }\n            _loading.value = false\n        }\n    }\n}\n
